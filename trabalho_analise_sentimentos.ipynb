ax.set_ylabel("F1-score (conjunto de teste)")
ax.set_xlabel("Experimento")
ax.set_title("Comparação de F1 por experimento e por modelo")
ax.legend(title="Modelo")
plt.xticks(rotation=30, ha="right")
plt.tight_layout()
plt.show()

